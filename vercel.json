{
  "crons": [
    {
      "path": "/api/ingest?force=1",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/reconcile",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/verify",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wc2026-xi-gray.vercel.app"
        }
      ],
      "destination": "https://compet.jeanlucs.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "wc2026-xi-gray.vercel.app"
        }
      ],
      "destination": "https://compet.jeanlucs.com/:path+",
      "permanent": true
    }
  ]
}
